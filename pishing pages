<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brave Browser Simulator</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome for exact web icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts for typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            jakarta: ['Plus Jakarta Sans', 'sans-serif'],
            roboto: ['Roboto', 'sans-serif']
          },
          colors: {
            braveBg: '#1c1822',
            braveTabActive: '#2d2736',
            braveTabInactive: '#211c29',
            braveInput: '#15111b',
            googleDark: '#131314',
            googleBg: '#0f0f10',
            fbBlue: '#1877f2',
            fbBg: '#ffffff',
            igBg: '#000000',
            igCard: '#121212',
            igInputBg: '#121212',
            igInputBorder: '#262626'
          }
        }
      }
    }
  </script>

  <style>
    /* Premium Smooth Easing & Transitions (Rule 003) */
    .smooth-transition {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .scale-on-click {
      transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .scale-on-click:active {
      transform: scale(0.95);
    }
    
    /* Scrollbar style */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 99px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    /* Shifting background gradient for Instagram close friends text */
    @keyframes textGradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .ig-gradient-text {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: textGradient 6s ease infinite;
    }

    /* Fade-in Animation for Simulated Views */
    @keyframes viewFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-view {
      animation: viewFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</head>
<body class="bg-[#0b0b0a] text-[#e3e3e3] select-none h-screen w-screen overflow-hidden flex flex-col font-sans">

  <!-- MAIN SIMULATED BROWSER CONTAINER -->
  <div id="browser-container" class="w-full h-full flex flex-col bg-braveBg text-sm select-none">
    
    <!-- TOP SECTION: TABS & WINDOW CONTROLS -->
    <div class="flex items-center justify-between bg-[#191520] pt-2 px-3 pb-0 select-none border-b border-[#2a2233]">
      
      <!-- Tabs List Container -->
      <div id="tabs-list" class="flex items-end space-x-[2px] overflow-x-auto max-w-[85%] pr-4 no-scrollbar">
        <!-- Tabs will be rendered here dynamically via JS -->
      </div>

      <!-- Window controls (Minimize, Maximize, Close) & Brave rewards -->
      <div class="flex items-center space-x-3 mb-2 ml-auto shrink-0 text-gray-400">
        <!-- Brave Shields / Crypto icon -->
        <button class="hover:text-white transition duration-200">
          <i class="fa-solid fa-triangle-exclamation text-[#ff763b] text-base"></i>
        </button>
        <!-- Windows System Buttons -->
        <div class="flex items-center space-x-4 pl-3 border-l border-gray-700/60 text-xs">
          <i class="fa-solid fa-minus hover:text-white cursor-pointer transition"></i>
          <i class="fa-regular fa-square hover:text-white cursor-pointer transition"></i>
          <i class="fa-solid fa-xmark hover:text-white cursor-pointer transition text-sm"></i>
        </div>
      </div>
    </div>

    <!-- MIDDLE SECTION: TOOLBAR & URL BAR -->
    <div class="flex items-center space-x-3 px-3 py-2 bg-braveTabActive border-b border-[#3c3349]/50 select-none">
      
      <!-- Nav Controls -->
      <div class="flex items-center space-x-4 text-gray-300">
        <button onclick="goBack()" class="hover:text-white transition scale-on-click" title="Back">
          <i class="fa-solid fa-arrow-left text-base"></i>
        </button>
        <button onclick="goForward()" class="hover:text-white transition scale-on-click" title="Forward">
          <i class="fa-solid fa-arrow-right text-base"></i>
        </button>
        <button id="refresh-btn" onclick="refreshPage()" class="hover:text-white transition scale-on-click" title="Reload page">
          <i class="fa-solid fa-rotate-right text-sm"></i>
        </button>
        <button onclick="goHome()" class="hover:text-white transition scale-on-click" title="Home page">
          <i class="fa-solid fa-house text-sm"></i>
        </button>
      </div>

      <!-- URL Address Bar -->
      <div class="flex-1 relative flex items-center">
        <!-- Brave Identity Icon left -->
        <div class="absolute left-3 text-gray-400 flex items-center space-x-1">
          <i class="fa-solid fa-lock text-emerald-500 text-xs"></i>
          <span class="text-xs text-emerald-500 opacity-90 hidden sm:inline">Secure</span>
        </div>
        
        <!-- Live simulated address bar input -->
        <input 
          id="address-bar" 
          type="text" 
          value="https://accounts.google.com" 
          onkeydown="handleUrlInput(event)"
          class="w-full bg-braveInput hover:bg-[#1a1522] focus:bg-[#130f1a] focus:ring-1 focus:ring-purple-500/50 outline-none text-xs rounded-lg py-[6px] pl-[74px] pr-28 text-gray-200 border border-[#3e344e] transition"
        />
        
        <!-- Address Bar utilities right -->
        <div class="absolute right-3 flex items-center space-x-3 text-gray-400 text-xs">
          <i class="fa-regular fa-star hover:text-yellow-400 cursor-pointer transition" title="Bookmark page"></i>
          <span class="bg-[#ff4e00]/20 text-[#ff763b] px-1.5 py-0.5 rounded text-[10px] font-bold">1 Shields</span>
          <i class="fa-solid fa-share-nodes hover:text-white cursor-pointer transition"></i>
        </div>
      </div>

      <!-- Extension Icons & Profile -->
      <div class="flex items-center space-x-3 text-gray-300 pl-1">
        <i class="fa-solid fa-puzzle-piece hover:text-white cursor-pointer transition text-sm" title="Extensions"></i>
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-[#9c27b0] to-[#e91e63] flex items-center justify-center text-[10px] font-bold text-white cursor-pointer">
          Z
        </div>
        <i class="fa-solid fa-ellipsis-vertical hover:text-white cursor-pointer transition text-base px-1"></i>
      </div>
    </div>

    <!-- BOOKMARKS BAR -->
    <div class="flex items-center justify-between px-4 py-1.5 bg-braveTabActive/90 border-b border-[#3c3349]/30 text-xs text-gray-300 select-none">
      <div class="flex items-center space-x-4">
        <!-- Google bookmark -->
        <div class="flex items-center space-x-1.5 hover:text-white cursor-pointer transition" onclick="switchPreset('google')">
          <i class="fa-brands fa-google text-red-400 text-[11px]"></i>
          <span>Google Sign in</span>
        </div>
        <!-- Facebook bookmark -->
        <div class="flex items-center space-x-1.5 hover:text-white cursor-pointer transition" onclick="switchPreset('facebook')">
          <i class="fa-brands fa-facebook text-blue-500 text-[12px]"></i>
          <span>Facebook Log in</span>
        </div>
        <!-- Instagram bookmark -->
        <div class="flex items-center space-x-1.5 hover:text-white cursor-pointer transition" onclick="switchPreset('instagram')">
          <i class="fa-brands fa-instagram text-pink-400 text-[12px]"></i>
          <span>Instagram</span>
        </div>
        <!-- Z.ai bookmark -->
        <div class="flex items-center space-x-1.5 hover:text-white cursor-pointer transition" onclick="switchPreset('zai')">
          <i class="fa-solid fa-wand-magic-sparkles text-purple-400 text-[11px]"></i>
          <span>Z.ai Platform</span>
        </div>
      </div>
      
      <!-- Right Bookmarks Utilities -->
      <div class="flex items-center space-x-1 hover:text-white cursor-pointer transition">
        <i class="fa-regular fa-folder text-yellow-500"></i>
        <span>Other favorites</span>
        <i class="fa-solid fa-chevron-down text-[8px] pl-0.5"></i>
      </div>
    </div>

    <!-- MAIN VIEWPORT: WHERE PAGES RENDER -->
    <div id="viewport-loading" class="hidden absolute inset-0 bg-black/70 z-50 flex items-center justify-center backdrop-blur-md">
      <div class="flex flex-col items-center space-y-4">
        <div class="w-10 h-10 border-4 border-purple-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs font-semibold tracking-wider text-gray-300">Resolving host...</p>
      </div>
    </div>

    <div id="browser-viewport" class="flex-1 bg-neutral-900 overflow-y-auto relative">
      <!-- Simulated pages are injected dynamically here based on active tab -->
    </div>
  </div>

  <!-- SCRIPT BLOCK HANDLING ALL SIMULATED PAGES & BROWSER LOGIC -->
  <script>
    // System & Browser Variables
    let tabs = [
      { id: 'zai', title: 'Z.ai - Free AI Platform', url: 'https://z.ai', favicon: 'fa-wand-magic-sparkles text-purple-400', active: false },
      { id: 'uiphilosophy', title: 'UI Design Philosophy', url: 'https://designphilosophy.io', favicon: 'fa-compass text-teal-400', active: false },
      { id: 'instagram', title: 'Instagram', url: 'https://instagram.com', favicon: 'fa-brands fa-instagram text-pink-500', active: false },
      { id: 'startpage', title: 'Startpage Search', url: 'https://startpage.com', favicon: 'fa-solid fa-magnifying-glass text-blue-400', active: false },
      { id: 'security', title: 'Security Dashboard', url: 'https://myaccount.google.com/security', favicon: 'fa-solid fa-shield-halved text-green-400', active: false },
      { id: 'google', title: 'Sign in - Google Accounts', url: 'https://accounts.google.com', favicon: 'fa-brands fa-google text-red-500', active: true },
      { id: 'facebook', title: 'Facebook', url: 'https://facebook.com', favicon: 'fa-brands fa-facebook text-blue-600', active: false },
      { id: 'x', title: 'Home / X', url: 'https://x.com', favicon: 'fa-brands fa-x-twitter text-white', active: false },
      { id: 'cursor', title: 'Cursor - The AI Code Editor', url: 'https://cursor.com', favicon: 'fa-solid fa-code text-indigo-400', active: false }
    ];

    let navigationHistory = {};
    tabs.forEach(tab => {
      navigationHistory[tab.id] = [tab.url];
    });

    let activeTabId = 'google';

    // Google App State variables
    let googleSignInStep = 'email'; // 'email' or 'password'
    let typedEmail = '';

    // Init App
    window.onload = function() {
      renderTabs();
      renderActivePage();
    };

    // Render Tabs list
    function renderTabs() {
      const tabListContainer = document.getElementById('tabs-list');
      tabListContainer.innerHTML = '';

      tabs.forEach((tab) => {
        const isActive = tab.active;
        const tabEl = document.createElement('div');
        tabEl.className = `group relative flex items-center space-x-2 px-3 py-2 cursor-pointer rounded-t-lg select-none transition-all duration-200 shrink-0 text-xs ${
          isActive 
            ? 'bg-braveTabActive text-white font-medium border-t-2 border-purple-500 z-10' 
            : 'bg-braveTabInactive text-gray-400 hover:bg-[#251f2f]/80 hover:text-gray-200'
        }`;
        tabEl.style.width = '145px';
        tabEl.setAttribute('onclick', `switchTab('${tab.id}')`);

        tabEl.innerHTML = `
          <div class="flex items-center space-x-1.5 w-full overflow-hidden">
            <i class="${tab.favicon} text-[11px] shrink-0"></i>
            <span class="truncate pr-4">${tab.title}</span>
          </div>
          <button onclick="closeTab(event, '${tab.id}')" class="absolute right-2 opacity-0 group-hover:opacity-100 hover:bg-[#3d324e] hover:text-white rounded px-1 py-0.2 text-[9px] transition-all duration-150 text-gray-400">
            <i class="fa-solid fa-xmark"></i>
          </button>
        `;

        tabListContainer.appendChild(tabEl);
      });

      const plusButton = document.createElement('button');
      plusButton.className = "mb-1 px-2.5 py-1.5 text-gray-400 hover:text-white hover:bg-braveTabActive rounded-md transition duration-200 scale-on-click text-xs";
      plusButton.innerHTML = `<i class="fa-solid fa-plus"></i>`;
      plusButton.onclick = createNewTab;
      tabListContainer.appendChild(plusButton);
    }

    // Switch Active Tab
    function switchTab(tabId) {
      tabs.forEach(t => t.active = false);
      const targetTab = tabs.find(t => t.id === tabId);
      if (targetTab) {
        targetTab.active = true;
        activeTabId = tabId;
        document.getElementById('address-bar').value = targetTab.url;
      }
      renderTabs();
      renderActivePage();
    }

    // Close Tab
    function closeTab(event, tabId) {
      event.stopPropagation();
      const index = tabs.findIndex(t => t.id === tabId);
      if (index === -1) return;

      if (tabs.length === 1) {
        return;
      }

      const wasActive = tabs[index].active;
      tabs.splice(index, 1);

      if (wasActive) {
        const nextActiveIndex = index === 0 ? 0 : index - 1;
        tabs[nextActiveIndex].active = true;
        activeTabId = tabs[nextActiveIndex].id;
        document.getElementById('address-bar').value = tabs[nextActiveIndex].url;
      }

      renderTabs();
      renderActivePage();
    }

    // Create New Tab
    function createNewTab() {
      const newId = 'tab_' + Date.now();
      const newTab = {
        id: newId,
        title: 'New Tab',
        url: 'https://google.com',
        favicon: 'fa-solid fa-magnifying-glass text-gray-400',
        active: true
      };

      tabs.forEach(t => t.active = false);
      tabs.push(newTab);
      activeTabId = newId;
      navigationHistory[newId] = [newTab.url];
      
      document.getElementById('address-bar').value = newTab.url;
      renderTabs();
      renderActivePage();
    }

    // Bookmark quick switch presets
    function switchPreset(presetKey) {
      let matchedTab = tabs.find(t => t.id === presetKey);
      if (matchedTab) {
        switchTab(presetKey);
      } else {
        let presetData = {
          google: { title: 'Sign in - Google Accounts', url: 'https://accounts.google.com', favicon: 'fa-brands fa-google text-red-500' },
          facebook: { title: 'Facebook', url: 'https://facebook.com', favicon: 'fa-brands fa-facebook text-blue-600' },
          instagram: { title: 'Instagram', url: 'https://instagram.com', favicon: 'fa-brands fa-instagram text-pink-500' },
          zai: { title: 'Z.ai - Free AI Platform', url: 'https://z.ai', favicon: 'fa-wand-magic-sparkles text-purple-400' }
        }[presetKey];

        const newTab = {
          id: presetKey,
          title: presetData.title,
          url: presetData.url,
          favicon: presetData.favicon,
          active: true
        };

        tabs.forEach(t => t.active = false);
        tabs.push(newTab);
        activeTabId = presetKey;
        navigationHistory[presetKey] = [newTab.url];
        
        document.getElementById('address-bar').value = newTab.url;
        renderTabs();
        renderActivePage();
      }
    }

    function goBack() {
      showRefreshAnimation();
    }

    function goForward() {
      showRefreshAnimation();
    }

    // Refresh simulation with real animation overlay
    function refreshPage() {
      const refreshBtn = document.getElementById('refresh-btn');
      refreshBtn.classList.add('animate-spin');
      showRefreshAnimation(() => {
        refreshBtn.classList.remove('animate-spin');
      });
    }

    function showRefreshAnimation(callback) {
      const loader = document.getElementById('viewport-loading');
      loader.classList.remove('hidden');
      setTimeout(() => {
        loader.classList.add('hidden');
        if(callback) callback();
        renderActivePage();
      }, 500);
    }

    // Handle Address Bar Enter Key
    function handleUrlInput(event) {
      if (event.key === 'Enter') {
        let inputVal = event.target.value.trim().toLowerCase();
        
        if (!inputVal.startsWith('http://') && !inputVal.startsWith('https://')) {
          inputVal = 'https://' + inputVal;
        }

        const activeTab = tabs.find(t => t.id === activeTabId);
        if (activeTab) {
          activeTab.url = inputVal;
          
          if (inputVal.includes('google.com')) {
            activeTab.title = 'Sign in - Google Accounts';
            activeTab.favicon = 'fa-brands fa-google text-red-500';
            activeTab.id = 'google';
          } else if (inputVal.includes('facebook.com')) {
            activeTab.title = 'Facebook';
            activeTab.favicon = 'fa-brands fa-facebook text-blue-600';
            activeTab.id = 'facebook';
          } else if (inputVal.includes('instagram.com')) {
            activeTab.title = 'Instagram';
            activeTab.favicon = 'fa-brands fa-instagram text-pink-500';
            activeTab.id = 'instagram';
          } else if (inputVal.includes('z.ai')) {
            activeTab.title = 'Z.ai - Free AI Platform';
            activeTab.favicon = 'fa-wand-magic-sparkles text-purple-400';
            activeTab.id = 'zai';
          } else {
            activeTab.title = inputVal.replace('https://', '').replace('www.', '');
            activeTab.favicon = 'fa-solid fa-globe text-indigo-400';
          }

          navigationHistory[activeTabId].push(inputVal);
        }

        showRefreshAnimation();
        renderTabs();
      }
    }

    // -----------------------------------------------------------------
    // RENDER ACTUAL INTERACTIVE PAGE CONTENT
    // -----------------------------------------------------------------
    function renderActivePage() {
      const viewport = document.getElementById('browser-viewport');
      const activeTab = tabs.find(t => t.id === activeTabId);

      if (!activeTab) return;

      viewport.innerHTML = '';

      if (activeTab.url.includes('google.com') && !activeTab.url.includes('myaccount')) {
        injectGooglePage(viewport);
      } else if (activeTab.url.includes('facebook.com')) {
        injectFacebookPage(viewport);
      } else if (activeTab.url.includes('instagram.com')) {
        injectInstagramPage(viewport);
      } else if (activeTab.url.includes('z.ai')) {
        injectZaiPage(viewport);
      } else if (activeTab.url.includes('designphilosophy.io')) {
        injectPhilosophyPage(viewport);
      } else if (activeTab.url.includes('startpage.com')) {
        injectStartpagePage(viewport);
      } else if (activeTab.url.includes('myaccount.google.com/security')) {
        injectSecurityPage(viewport);
      } else if (activeTab.url.includes('x.com')) {
        injectTwitterPage(viewport);
      } else if (activeTab.url.includes('cursor.com')) {
        injectCursorPage(viewport);
      } else {
        injectDefaultPage(viewport, activeTab.url);
      }
    }

    // ==========================================
    // 1. GOOGLE SIGN IN PAGE (Image Matches 100%)
    // ==========================================
    function injectGooglePage(container) {
      const pageWrapper = document.createElement('div');
      pageWrapper.className = "min-h-full w-full bg-googleBg flex flex-col justify-between items-center py-12 px-6 font-roboto select-none animate-view";
      
      const cardHtml = googleSignInStep === 'email' ? getGoogleEmailStepHtml() : getGooglePasswordStepHtml();

      pageWrapper.innerHTML = `
        <div class="flex-1 flex items-center justify-center w-full">
          <!-- Main Google Login Card -->
          <div class="bg-googleDark border border-neutral-800 rounded-[28px] p-10 md:p-12 max-w-[1040px] w-full min-h-[480px] grid grid-cols-1 md:grid-cols-2 gap-12 items-start smooth-transition">
            
            <!-- Left Half: Title & Subtitle -->
            <div class="flex flex-col space-y-4">
              <!-- Precise colored Google G SVG logo -->
              <svg class="h-10 w-auto self-start" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v3.92h6.61c-.29 1.5-1.14 2.77-2.4 3.61v3h3.84c2.24-2.06 3.69-5.1 3.69-8.46z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.84-3c-1.08.72-2.45 1.16-4.09 1.16-3.15 0-5.81-2.13-6.76-5.01H1.31v3.1A12 12 0 0 0 12 24z"/>
                <path fill="#FBBC05" d="M5.24 14.24a7.15 7.15 0 0 1 0-4.48v-3.1H1.31a12 12 0 0 0 0 10.68l3.93-3.1z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.43-3.43A11.93 11.93 0 0 0 12 0 12 12 0 0 0 1.31 6.66l3.93 3.1c.95-2.88 3.61-5.01 6.76-5.01z"/>
              </svg>
              
              <h1 class="text-4xl text-[#e3e3e3] font-normal leading-tight font-sans pt-3">Sign in</h1>
              <p class="text-[16px] text-[#c4c7c5]">Use your Google Account</p>
            </div>

            <!-- Right Half: Dynamic interactive sign-in layout -->
            <div class="flex flex-col space-y-6 pt-4 md:pt-0">
              ${cardHtml}
            </div>

          </div>
        </div>

        <!-- Google Footer -->
        <div class="max-w-[1040px] w-full flex flex-col sm:flex-row justify-between items-center text-xs text-[#a8aaaa] pt-6 gap-4 border-t border-transparent">
          <div class="relative group cursor-pointer flex items-center space-x-1.5 hover:text-white transition duration-200">
            <span>English (United States)</span>
            <i class="fa-solid fa-caret-down text-[10px]"></i>
          </div>
          <div class="flex items-center space-x-6">
            <a href="#" class="hover:text-white transition duration-200">Help</a>
            <a href="#" class="hover:text-white transition duration-200">Privacy</a>
            <a href="#" class="hover:text-white transition duration-200">Terms</a>
          </div>
        </div>
      `;

      container.appendChild(pageWrapper);

      const emailInput = document.getElementById('google-email');
      const passInput = document.getElementById('google-pass');

      if (emailInput) {
        emailInput.addEventListener('focus', () => toggleGoogleLabel(true, 'label-email', 'google-email-border'));
        emailInput.addEventListener('blur', () => toggleGoogleLabel(emailInput.value !== '', 'label-email', 'google-email-border'));
      }
      if (passInput) {
        passInput.addEventListener('focus', () => toggleGoogleLabel(true, 'label-pass', 'google-pass-border'));
        passInput.addEventListener('blur', () => toggleGoogleLabel(passInput.value !== '', 'label-pass', 'google-pass-border'));
      }
    }

    function getGoogleEmailStepHtml() {
      return `
        <!-- Floating Label Input Wrapper -->
        <div class="relative w-full">
          <div id="google-email-border" class="border border-neutral-700 rounded-lg p-4 flex items-center smooth-transition focus-within:border-blue-400 focus-within:ring-1 focus-within:ring-blue-400">
            <input 
              id="google-email" 
              type="text" 
              value="${typedEmail}"
              class="w-full bg-transparent outline-none border-none text-[16px] text-white pt-1 pb-1"
            />
            <label id="label-email" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-[16px] pointer-events-none transition-all duration-200 origin-left ${typedEmail ? 'top-1 -translate-y-0 text-xs text-blue-400 bg-googleDark px-1' : ''}">
              Email or phone
            </label>
          </div>
        </div>

