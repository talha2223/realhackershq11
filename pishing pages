              <i class="fa-solid fa-mobile-screen text-xl text-red-400"></i>
              <h3 class="font-bold">Logged Devices</h3>
              <p class="text-xs text-neutral-400">Verify devices with active tokens currently on your profile.</p>
              <span class="text-xs text-neutral-400">3 active devices</span>
            </div>
          </div>
        </div>
      `;

      container.appendChild(pageWrapper);
    }

    // ==========================================
    // 8. TWITTER / X SIMULATED FEED PAGE
    // ==========================================
    function injectTwitterPage(container) {
      const pageWrapper = document.createElement('div');
      pageWrapper.className = "min-h-full w-full bg-black text-white flex flex-col select-none animate-view";

      pageWrapper.innerHTML = `
        <div class="max-w-[600px] mx-auto w-full border-x border-neutral-800 flex-1 flex flex-col">
          <div class="sticky top-0 bg-black/80 backdrop-blur-md border-b border-neutral-800 px-4 py-3 flex justify-between items-center">
            <span class="font-bold text-lg">Home</span>
            <i class="fa-solid fa-sparkles text-sm"></i>
          </div>

          <div class="p-4 border-b border-neutral-800 flex space-x-3 items-start hover:bg-white/5 cursor-pointer">
            <div class="w-10 h-10 rounded-full bg-blue-500 shrink-0"></div>
            <div class="flex-1 flex flex-col space-y-1">
              <div class="flex items-center space-x-1.5 text-xs text-neutral-400">
                <span class="font-bold text-white text-sm">Developer Pro</span>
                <span>@dev_pro</span>
                <span>• 2h</span>
              </div>
              <p class="text-sm leading-relaxed">
                Just completed the visual layout clones for the new system simulator. Everything feels incredibly quick and reliable. ✨
              </p>
              <div class="flex justify-between text-neutral-500 text-xs pt-2 pr-10">
                <span><i class="fa-regular fa-comment"></i> 12</span>
                <span><i class="fa-solid fa-retweet"></i> 4</span>
                <span><i class="fa-regular fa-heart"></i> 45</span>
              </div>
            </div>
          </div>
        </div>
      `;

      container.appendChild(pageWrapper);
    }

    // ==========================================
    // 9. CURSOR LANDING PAGE
    // ==========================================
    function injectCursorPage(container) {
      const pageWrapper = document.createElement('div');
      pageWrapper.className = "min-h-full w-full bg-[#050505] text-[#b0b0b0] flex flex-col justify-between items-center py-20 px-6 select-none animate-view";

      pageWrapper.innerHTML = `
        <div class="max-w-[800px] w-full flex flex-col items-center justify-center space-y-8 text-center">
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white font-jakarta">
            The AI-first <br>Code Editor
          </h1>
          <p class="text-neutral-400 max-w-[500px] text-sm leading-relaxed">
            Built around Copilot, Cursor is the editor of choice for writing code cleanly and efficiently.
          </p>
          <div class="flex items-center space-x-4">
            <button class="bg-white hover:bg-neutral-200 text-black text-xs font-bold px-6 py-3 rounded-lg transition scale-on-click">
              Download for Windows
            </button>
            <button class="bg-neutral-900 border border-neutral-800 text-xs text-white px-6 py-3 rounded-lg hover:bg-neutral-800">
              Read Docs
            </button>
          </div>
        </div>
      `;

      container.appendChild(pageWrapper);
    }

    // ==========================================
    // 10. DEFAULT / FALLBACK SEARCH ENGINE
    // ==========================================
    function injectDefaultPage(container, url) {
      const pageWrapper = document.createElement('div');
      pageWrapper.className = "min-h-full w-full bg-[#18181b] text-neutral-300 flex flex-col items-center justify-center p-8 text-center select-none animate-view";

      pageWrapper.innerHTML = `
        <div class="max-w-md w-full bg-[#27272a] border border-neutral-700 rounded-2xl p-8 flex flex-col items-center space-y-4">
          <i class="fa-solid fa-earth-americas text-4xl text-neutral-500 animate-pulse"></i>
          <h2 class="text-xl font-bold text-white">Simulated Navigation Success</h2>
          <p class="text-xs text-neutral-400">
            You successfully browsed to <span class="text-neutral-200 font-mono underline block mt-1">${url}</span>
          </p>
          <div class="text-[11px] text-neutral-500">
            All buttons and tab components in this frame are responsive. Use the bookmarks to access login pages.
          </div>
          <button onclick="goHome()" class="bg-neutral-800 hover:bg-neutral-700 text-white text-xs font-bold py-2 px-4 rounded-lg transition">
            Go Home
          </button>
        </div>
      `;

      container.appendChild(pageWrapper);
    }

    // ==========================================
    // SYSTEM DYNAMIC DIALOGUES / ACTIONS
    // ==========================================
    function loginSuccessful(platformName) {
      const modal = document.createElement('div');
      modal.className = "fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm";
      modal.innerHTML = `
        <div class="bg-neutral-900 border border-neutral-800 p-6 rounded-2xl max-w-sm w-full text-center flex flex-col items-center space-y-4">
          <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 text-xl">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 class="text-lg font-bold text-white">Login Successful!</h3>
          <p class="text-xs text-neutral-400">Successfully authenticated via the simulated ${platformName} terminal view.</p>
          <button id="close-modal-btn" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold py-2 px-6 rounded-lg transition-all duration-150">
            Continue
          </button>
        </div>
      `;
      document.body.appendChild(modal);

      document.getElementById('close-modal-btn').onclick = () => {
        modal.remove();
        switchPreset('zai');
      };
    }

    function openMockRegister(platformName) {
      const modal = document.createElement('div');
      modal.className = "fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm";
      modal.innerHTML = `
        <div class="bg-neutral-900 border border-neutral-800 p-6 rounded-2xl max-w-sm w-full text-center flex flex-col items-center space-y-4">
          <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 text-xl">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <h3 class="text-lg font-bold text-white">Create New Account</h3>
          <p class="text-xs text-neutral-400">Enter simple credentials to proceed with simulated registration for ${platformName}.</p>
          <input type="text" placeholder="Full Name" class="w-full bg-neutral-800 border border-neutral-700 rounded p-2 text-xs text-white outline-none focus:border-blue-500" />
          <input type="email" placeholder="Email Address" class="w-full bg-neutral-800 border border-neutral-700 rounded p-2 text-xs text-white outline-none focus:border-blue-500" />
          <button id="submit-reg-btn" class="bg-blue-500 hover:bg-blue-600 text-white text-xs font-bold py-2 px-6 rounded-lg transition-all duration-150 w-full">
            Register
          </button>
        </div>
      `;
      document.body.appendChild(modal);

      document.getElementById('submit-reg-btn').onclick = () => {
        modal.remove();
        loginSuccessful(platformName);
      };
    }
  </script>
